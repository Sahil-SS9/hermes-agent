# Track only declarative profile config (config.yaml, SOUL.md, USER.md,
# curriculum.yaml, skill overrides, mcp config). Everything below is
# secrets, credentials, runtime state, caches, or cloned task workspaces.

# Secrets and credentials
.env
.env.*
*.key
*.pem
*.p12
auth.json
*.auth.json
*_token.json
*_tokens.json
credentials.json
token_cache*

# Databases (WAL/SHM are sidecar files)
*.db
*.db-shm
*.db-wal

# Runtime / ephemeral state
sessions/
state/
checkpoints/
kanban/
workspaces/
home/
logs/
bin/
cron/output/
gateway_state.json
gateway_voice_mode.json
gateway.lock
gateway.pid
context_length_cache.yaml
models_dev_cache.json
.update_check
.skills_prompt_snapshot.json
.bundled_manifest
.usage.json
.no-bundled-skills

# LSP / tooling
lsp/
__pycache__/
*.pyc
*.pyo

# Node / dependencies
node_modules/
package-lock.json

# Archived profiles
_archived/

# Stale backups
*.bak
*-bak-*
*.discord-only-bak-*

# Lock files
*.lock

# Python venv / build artefacts
.venv/
*.egg-info/
.pytest-cache/
.pytest_cache/

# Built web assets
hermes_cli/web_dist/

# Runtime working dirs and agent output
.hermes_work/
investigations/
reports/
runbooks/
content_engine/data/
content_engine/inbox/
content_engine/output/
content_engine/.pytest-cache/
data/github-radar/
scripts/.backup-staleness-state.json

# Stray agent report artefacts
recommendation-report-*.md
report-t_*.md
t_*-report.md
t_*-investigation-report.md
t_*-wesker*-report.md
t_*_recommendation_report.md
FILETREE.md
*.bak.*
t_*_report.md
