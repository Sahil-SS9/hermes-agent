gateway_voice_mode.json
gateway.lock
gateway.pid
context_length_cache.yaml
models_dev_cache.json
.update_check
.skills_prompt_snapshot.json
.bundled_manifest
.usage.json
.no-bundled-skills

# LSP / tooling
lsp/
__pycache__/
*.pyc
*.pyo

# Node / dependencies
node_modules/
package-lock.json

# Archived profiles
_archived/

# Stale backups
*.bak
*-bak-*
*.discord-only-bak-*

