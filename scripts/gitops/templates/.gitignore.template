# KENSEI GitOps — .gitignore for ~/.hermes
# Two-layer: (1) deny everything at top level, (2) allow curated paths,
# (3) deny runtime junk INSIDE curated paths.
# Generated by scripts/gitops/install.sh — do not hand-edit in ~/.hermes.

# --- 1. Default-deny at top level ---
/*

# --- 2. Curated paths (whitelist) ---
!/config.yaml
!/profiles
!/profiles/**
!/cron
!/cron/**
!/governance
!/governance/**
!/scripts
!/scripts/**
!/skills
!/skills/**
!/runbooks
!/runbooks/**
!/feature-artifacts
!/feature-artifacts/**

# --- 3. Internal runtime junk inside curated paths ---
# Python
**/__pycache__/
**/*.pyc
**/*.pyo
# Lock files
**/*.lock
# Databases / SQLite
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
# Tmp / scratch
**/*.tmp
# Backup / superseded (cron jobs.json.bak-*, SKILL.md.bak, .sqlite.superseded-*)
**/*.bak
**/*.bak-*
**/*.superseded-*
# Logs
**/*.log
# Cron outputs (the JSON config is what we track, the output dir is junk)
cron/output/
# Feature-artifacts: only .md files tracked; deny everything else inside.
feature-artifacts/**
!feature-artifacts/**/*.md

# --- 4. Always allow these, regardless of position ---
!.gitignore
!.gitignore.bak
!.gitkeep
